        "import random\n",
        "\n",
        "def cost(board):\n",
        "    c = 0\n",
        "    for i in range(4):\n",
        "        for j in range(i + 1, 4):\n",
        "            if board[i] == board[j] or abs(board[i] - board[j]) == abs(i - j):\n",
        "                c += 1\n",
        "    return c\n",
        "\n",
        "def hill_climbing():\n",
        "    board = list(map(int, input(\"Enter initial state (4 rows, 1-4): \").split()))\n",
        "    board = [x - 1 for x in board]\n",
        "\n",
        "    while cost(board) != 0:\n",
        "        best = board[:]\n",
        "\n",
        "        for col in range(4):\n",
        "            for row in range(4):\n",
        "                temp = board[:]\n",
        "                temp[col] = row\n",
        "\n",
        "                if cost(temp) < cost(best):\n",
        "                    best = temp\n",
        "\n",
        "        if best == board:\n",
        "            board = [random.randint(0, 3) for _ in range(4)]\n",
        "        else:\n",
        "            board = best\n",
        "\n",
        "    print(\"Solution:\", [x + 1 for x in board])\n",
        "    print(\"Cost:\", cost(board))\n",
        "    print(\"K ABHIRAMA PURANIKA,1WN24CS127\")\n",
        "\n",
        "    for row in range(4):\n",
        "        print(\" \".join(\"Q\" if board[col] == row else \".\" for col in range(4)))\n",
        "\n",
        "hill_climbing()\n"
      ]
    }
